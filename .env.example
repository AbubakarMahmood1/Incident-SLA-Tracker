# Copy to .env for local development. Never commit the populated file.
APP_NAME=incident-sla-ledger
APP_ENV=development
LOG_LEVEL=INFO

# The API will refuse placeholder JWT secrets outside test/development.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=incident-sla-ledger
JWT_AUDIENCE=incident-sla-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=postgresql+psycopg://incident:incident@localhost:5432/incident_sla
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Comma-separated exact origins. Leave empty for non-browser/API-only deployments.
CORS_ORIGINS=http://localhost:3000

# SLA policy snapshot defaults, in minutes.
SLA_CRITICAL_RESPONSE_MINUTES=15
SLA_CRITICAL_RESOLUTION_MINUTES=240
SLA_HIGH_RESPONSE_MINUTES=60
SLA_HIGH_RESOLUTION_MINUTES=1440
SLA_MEDIUM_RESPONSE_MINUTES=240
SLA_MEDIUM_RESOLUTION_MINUTES=4320
SLA_LOW_RESPONSE_MINUTES=1440
SLA_LOW_RESOLUTION_MINUTES=10080

# Worker and durable-outbox settings.
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LEASE_SECONDS=120
OUTBOX_TRANSPORT=console

# Required only when OUTBOX_TRANSPORT=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
